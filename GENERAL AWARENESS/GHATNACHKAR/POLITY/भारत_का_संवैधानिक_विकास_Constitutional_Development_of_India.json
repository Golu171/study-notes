[
  {
    "question": "<style>*{overflow-wrap: break-word;} img {max-width:100% !important} </style><style type=\"text/css\">img, svg {vertical-align: middle; max-width:100%; } *{overflow-wrap: break-word;}\r\n</style>\r\n<p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-family:'Palanquin Dark'\">निम्नलिखित में से किस अधिनियम में कलकत्ता में सर्वोच्च न्यायालय की स्थापना का प्रावधान किया गया था?</span></p>\r\n\r\n<p style=\"margin-top:0pt;margin-bottom:0pt\">&nbsp;</p>\r\n\r\n<p style=\"margin-top:0pt;margin-bottom:0pt\"><span>Which of the following Acts provided for the establishment of the Supreme Court at Calcutta?</span></p>",
