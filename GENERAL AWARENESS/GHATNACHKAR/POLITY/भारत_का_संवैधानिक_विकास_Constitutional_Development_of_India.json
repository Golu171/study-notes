      "<style>*{overflow-wrap: break-word;} img {max-width:100% !important} </style><p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-family:'Palanquin Dark'\">केवल 2 / Only 2</span></p>",
      "<style>*{overflow-wrap: break-word;} img {max-width:100% !important} </style><p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-family:'Palanquin Dark'\">दोनों 1 और 2 / Both 1 and 2</span></p>",
