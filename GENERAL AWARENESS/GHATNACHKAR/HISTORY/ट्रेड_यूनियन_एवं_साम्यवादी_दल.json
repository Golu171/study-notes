[
  {
    "question": "<style>*{overflow-wrap: break-word;} img {max-width:100% !important} </style><style type=\"text/css\">img, svg {vertical-align: middle; max-width:100%; } *{overflow-wrap: break-word;}\r\n</style>\r\n<p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-family:'Palanquin Dark'\">भारत में 1918 में &#39;प्रथम मजदूर संघ&#39; (First Trade Union) की स्थापना की&mdash;</span></p>\r\n\r\n<p style=\"margin-top:0pt;margin-bottom:0pt\">&nbsp;</p>\r\n\r\n<p style=\"margin-top:0pt;margin-bottom:0pt\"><span>Who established the &#39;First Trade Union&#39; in India in 1918?</span></p>\r\n\r\n<p style=\"margin-top:0pt;margin-bottom:0pt\">&nbsp;</p>",
    "options": [
      "<style>*{overflow-wrap: break-word;} img {max-width:100% !important} </style><p style=\"margin-top:0pt;margin-bottom:0pt\"><span>एन.एम. जोशी ने / N.M. Joshi</span></p>",
      "<style>*{overflow-wrap: break-word;} img {max-width:100% !important} </style><p style=\"margin-top:0pt;margin-bottom:0pt\"><span>बी.पी. वाडिया ने / B.P. Wadia</span></p>",
