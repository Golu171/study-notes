<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Pro International JSON Quiz Engine</title>
<!-- FontAwesome & Google Fonts -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* CSS Variables & Light/Dark Mode Logic */
:root {
  --p: #4F46E5; --p2: #7C3AED; --p3: #EC4899;
  --pg: rgba(79,70,229,.15); --pg2: rgba(79,70,229,.08);
  --ok: #059669; --ok-bg: rgba(5,150,105,.1); --ok-b: rgba(5,150,105,.3);
  --err: #DC2626; --err-bg: rgba(220,38,38,.1); --err-b: rgba(220,38,38,.3);
  --warn: #D97706; --warn-bg: rgba(217,119,6,.1); --warn-b: rgba(217,119,6,.3);
  --bg: #F8F9FA; --card: #ffffff; --sf: #F1F5F9; --sf2: #E2E8F0;
  --txt: #0F172A; --txt2: #334155; --mu: #64748B; --br: #E2E8F0;
  --sh: 0 4px 12px rgba(0,0,0,.05);
  --bottom-nav-bg: #ffffff;
}

[data-theme="dark"] {
  --bg: #0B1120; --card: #1E293B; --sf: #0F172A; --sf2: #1E2D45;
  --txt: #F8FAFC; --txt2: #CBD5E1; --mu: #94A3B8; --br: #334155;
  --sh: 0 4px 12px rgba(0,0,0,.3);
  --bottom-nav-bg: #1E293B;
}

* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--txt); transition: background 0.3s, color 0.3s; padding-bottom: 80px; }

/* Top Navbar */
.top-nav { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--card); border-bottom: 1px solid var(--br); box-shadow: var(--sh); position: sticky; top: 0; z-index: 100; }
.nav-left { display: flex; align-items: center; gap: 12px; }
.nav-right { display: flex; align-items: center; gap: 10px; }
.icon-btn { width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--br); background: var(--sf); color: var(--txt); display: flex; justify-content: center; align-items: center; cursor: pointer; transition: 0.2s ease; font-size: 16px; }
.icon-btn:hover { background: var(--pg); color: var(--p); border-color: var(--p); transform: translateY(-2px); }

/* Language Toggle */
.lang-toggle { display: flex; background: var(--sf); border-radius: 8px; padding: 4px; border: 1px solid var(--br); }
.lang-toggle button { border: none; background: transparent; padding: 6px 12px; border-radius: 6px; font-weight: 600; color: var(--mu); cursor: pointer; font-size: 14px; transition: 0.3s; }
.lang-toggle button.active { background: var(--p); color: #fff; box-shadow: 0 2px 6px var(--pg); }

/* Sub Header (Q No & Timer) */
.sub-header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; font-weight: 700; font-size: 15px; color: var(--txt); background: var(--bg); }
.timer { display: flex; align-items: center; gap: 6px; color: var(--txt2); }

/* Main Question Area */
.quiz-container { max-width: 800px; margin: 0 auto; padding: 0 20px; }
.question-box { background: var(--card); padding: 25px; border-radius: 16px; box-shadow: var(--sh); border: 1px solid var(--br); margin-bottom: 20px; }
.q-text { font-size: 18px; font-weight: 600; line-height: 1.6; margin-bottom: 25px; color: var(--txt); }

/* Options */
.options-list { display: flex; flex-direction: column; gap: 12px; }
.opt-item { display: flex; align-items: center; gap: 15px; padding: 16px 20px; background: var(--sf); border: 2px solid var(--br); border-radius: 12px; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); font-weight: 500; font-size: 16px; color: var(--txt); }
.opt-item:hover { border-color: var(--p); background: var(--pg); transform: translateX(5px); }
.opt-item:active { transform: scale(0.98); }
.opt-letter { width: 32px; height: 32px; border-radius: 50%; background: var(--card); border: 2px solid var(--br); display: flex; justify-content: center; align-items: center; font-weight: 700; font-size: 14px; color: var(--txt2); transition: 0.2s; }

/* State Classes */
.opt-item.selected { border-color: var(--p); background: var(--pg); }
.opt-item.selected .opt-letter { background: var(--p); color: #fff; border-color: var(--p); }
.opt-item.correct { border-color: var(--ok); background: var(--ok-bg); }
.opt-item.correct .opt-letter { background: var(--ok); color: #fff; border-color: var(--ok); }
.opt-item.wrong { border-color: var(--err); background: var(--err-bg); }
.opt-item.wrong .opt-letter { background: var(--err); color: #fff; border-color: var(--err); }
.opt-item.disabled { pointer-events: none; opacity: 0.7; }

/* Explanation Section */
.explanation-box { background: var(--card); border-radius: 16px; border: 1px solid var(--br); box-shadow: var(--sh); overflow: hidden; display: none; animation: slideDown 0.3s ease-out; margin-bottom: 20px; }
@keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
.expl-header { background: #fdf6e3; padding: 12px 20px; display: flex; align-items: center; gap: 10px; font-weight: 700; color: #b45309; font-size: 15px; border-bottom: 1px solid var(--br); }
[data-theme="dark"] .expl-header { background: #382bf01a; color: #fbbf24; }
.expl-content { padding: 20px; font-size: 15px; line-height: 1.7; color: var(--txt2); }
.correct-answer-text { font-weight: 700; color: var(--txt); margin-bottom: 15px; font-size: 16px; }
.correct-answer-text span { color: var(--p); }
.key-points-title { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--ok); font-size: 17px; margin-bottom: 10px; }
.expl-content ul { padding-left: 20px; margin-bottom: 15px; }
.expl-content li { margin-bottom: 8px; }
.desi-trick { background: var(--pg); border-left: 4px solid var(--p); padding: 12px 15px; border-radius: 0 8px 8px 0; font-weight: 600; color: var(--p2); margin-top: 15px; display: flex; flex-direction: column; gap: 5px; }
.desi-trick span { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--mu); }

/* Bottom Navigation */
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: var(--bottom-nav-bg); padding: 12px 20px; border-top: 1px solid var(--br); box-shadow: 0 -4px 12px rgba(0,0,0,.05); display: flex; justify-content: space-between; align-items: center; z-index: 100; }
.nav-btn { background: var(--sf); border: 1px solid var(--br); color: var(--txt); padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
.nav-btn:hover { background: var(--pg); color: var(--p); border-color: var(--p); }
.nav-btn.primary { background: var(--p); color: #fff; border-color: var(--p); }
.nav-btn.primary:hover { background: var(--p2); transform: translateY(-2px); box-shadow: 0 4px 10px var(--pg); }
.mid-actions { display: flex; gap: 15px; }
.mid-btn { background: transparent; border: 1px solid var(--br); color: var(--txt); padding: 10px 15px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s; }
.mid-btn:hover { background: var(--sf2); }

@media(max-width: 600px) {
  .sub-header { padding: 10px 15px; }
  .quiz-container { padding: 0 10px; }
  .question-box { padding: 15px; }
  .mid-actions span { display: none; } /* Hide text on small screens */
}
</style>
</head>
<body>

<!-- Top Navigation -->
<div class="top-nav">
  <div class="nav-left">
    <div class="icon-btn" title="Back"><i class="fa-solid fa-arrow-left"></i></div>
    <div class="lang-toggle">
      <button class="active">EN</button>
      <button>HI</button>
    </div>
  </div>
  <div class="nav-right">
    <div class="icon-btn" onclick="toggleTheme()" title="Light/Dark Mode"><i class="fa-solid fa-circle-half-stroke"></i></div>
    <div class="icon-btn" onclick="toggleFullScreen()" title="Full Screen"><i class="fa-solid fa-expand"></i></div>
    <div class="icon-btn" title="Menu"><i class="fa-solid fa-grip"></i></div>
  </div>
</div>

<!-- Sub Header -->
<div class="sub-header">
  <div id="q-counter">Q 1 / 20</div>
  <div class="timer"><i class="fa-regular fa-clock"></i> <span id="time-display">59:32</span></div>
</div>

<!-- Quiz Main Container -->
<div class="quiz-container">
  <!-- Question Box -->
  <div class="question-box">
    <div class="q-text" id="question-text">Loading question...</div>
    <div class="options-list" id="options-container">
      <!-- Options injected by JS -->
    </div>
  </div>

  <!-- Explanation Box -->
  <div class="explanation-box" id="explanation-container">
    <div class="expl-header">
      <i class="fa-regular fa-lightbulb"></i> Explanation
    </div>
    <div class="expl-content">
      <div class="correct-answer-text">Correct Answer is <span id="correct-ans-label">...</span>.</div>
      <div class="key-points-title"><i class="fa-solid fa-key"></i> Key Points</div>
      <ul id="expl-bullets">
        <!-- Bullet points injected here -->
      </ul>
      <div class="desi-trick" id="desi-trick-container">
        <span><i class="fa-solid fa-wand-magic-sparkles"></i> Memory Trick</span>
        <div id="desi-trick-text"></div>
      </div>
    </div>
  </div>
</div>

<!-- Bottom Navigation -->
<div class="bottom-nav">
  <button class="nav-btn" onclick="prevQuestion()"><i class="fa-solid fa-arrow-left"></i></button>
  <div class="mid-actions">
    <button class="mid-btn"><i class="fa-regular fa-star"></i> <span>Save</span></button>
    <button class="mid-btn"><i class="fa-solid fa-list-ul"></i> <span>Questions</span></button>
  </div>
  <button class="nav-btn primary" onclick="nextQuestion()">Next <i class="fa-solid fa-arrow-right"></i></button>
</div>

<script>
/* ==========================================
   JSON DATA STRUCTURE (Your Content Here)
   ========================================== */
const quizData = [
  {
    id: 121,
    question: "Select the most appropriate synonym of the given word: ABATE",
    options: ["Increase", "Subside", "Provoke", "Extend", "Unanswered"],
    correctIndex: 1, // 0-based index (1 = Subside)
    explanationBullets: [
      "The word 'Abate' means (of something perceived as hostile, threatening, or negative) become less intense or widespread.",
      "Synonyms of Abate include: subside, die down, lessen, ease off.",
      "Therefore, 'Subside' is the correct synonym."
    ],
    desiTrick: "A + bate (weight) ➡️ Apna weight 'abate' (kam) karo. Abate means to reduce or become less."
  },
  {
    id: 122,
    question: "Select the most appropriate antonym of the given word: GREGARIOUS",
    options: ["Sociable", "Introverted", "Talkative", "Outgoing", "Unanswered"],
    correctIndex: 1,
    explanationBullets: [
      "'Gregarious' refers to a person who is fond of company; sociable.",
      "Antonyms include: unsociable, introverted, reserved.",
      "Hence, 'Introverted' is the exact opposite."
    ],
    desiTrick: "Greg (Ek ladka) + rious (hilarious) ➡️ Greg is very hilarious and sociable, always surrounded by friends."
  },
  {
    id: 123,
    question: "In the double helix structure of human DNA, the nitrogenous bases are linked together via which bonds?",
    options: ["Covalent Bonds", "Ionic Bonds", "Hydrogen Bonds", "Histone", "Unanswered"],
    correctIndex: 2,
    explanationBullets: [
      "In the double-helix structure of human DNA, nitrogenous bases are linked together via Hydrogen bonds.",
      "The base Adenine (A) pairs specifically with Thymine (T) in DNA.",
      "Adenine forms two hydrogen bonds with Thymine to ensure the stability of the DNA structure."
    ],
    desiTrick: "H-Bond (Hydrogen) DNA ke dono strands ko 'Hold' karke rakhta hai."
  }
];

/* ==========================================
   ENGINE LOGIC
   ========================================== */
let currentIndex = 0;
let hasAnswered = false;

// DOM Elements
const qText = document.getElementById('question-text');
const optContainer = document.getElementById('options-container');
const explContainer = document.getElementById('explanation-container');
const explBullets = document.getElementById('expl-bullets');
const correctLabel = document.getElementById('correct-ans-label');
const trickContainer = document.getElementById('desi-trick-container');
const trickText = document.getElementById('desi-trick-text');
const qCounter = document.getElementById('q-counter');

// Initialize First Question
function loadQuestion(index) {
  hasAnswered = false;
  explContainer.style.display = 'none';
  
  const data = quizData[index];
  qCounter.innerText = `Q ${index + 1} / ${quizData.length}`;
  qText.innerText = data.question;
  
  // Render Options
  optContainer.innerHTML = '';
  const letters = ['A', 'B', 'C', 'D', 'E'];
  
  data.options.forEach((opt, i) => {
    const optDiv = document.createElement('div');
    optDiv.className = 'opt-item';
    optDiv.innerHTML = `<div class="opt-letter">${letters[i]}</div> <span class="opt-text">${opt}</span>`;
    
    optDiv.onclick = () => handleOptionClick(optDiv, i, data.correctIndex);
    optContainer.appendChild(optDiv);
  });
}

function handleOptionClick(selectedDiv, selectedIdx, correctIdx) {
  if (hasAnswered) return; // Prevent multiple clicks
  hasAnswered = true;
  
  const allOptions = optContainer.querySelectorAll('.opt-item');
  allOptions.forEach(opt => opt.classList.add('disabled'));

  // Logic for Unanswered (Option E usually)
  const isUnanswered = selectedIdx === 4; 

  if (isUnanswered) {
    selectedDiv.classList.add('selected');
    allOptions[correctIdx].classList.add('correct'); // Show correct anyway
  } else if (selectedIdx === correctIdx) {
    selectedDiv.classList.add('correct');
  } else {
    selectedDiv.classList.add('wrong');
    allOptions[correctIdx].classList.add('correct'); // Highlight actual correct answer
  }

  showExplanation();
}

function showExplanation() {
  const data = quizData[currentIndex];
  
  // Set correct answer text
  correctLabel.innerText = data.options[data.correctIndex];
  
  // Populate bullets
  explBullets.innerHTML = '';
  data.explanationBullets.forEach(bullet => {
    const li = document.createElement('li');
    li.innerText = bullet;
    explBullets.appendChild(li);
  });

  // Populate Trick
  if (data.desiTrick) {
    trickContainer.style.display = 'flex';
    trickText.innerText = data.desiTrick;
  } else {
    trickContainer.style.display = 'none';
  }

  explContainer.style.display = 'block';
  
  // Scroll to explanation smoothly
  setTimeout(() => {
    explContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }, 100);
}

function nextQuestion() {
  if (currentIndex < quizData.length - 1) {
    currentIndex++;
    loadQuestion(currentIndex);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

function prevQuestion() {
  if (currentIndex > 0) {
    currentIndex--;
    loadQuestion(currentIndex);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

/* ==========================================
   UTILITY FUNCTIONS
   ========================================== */
function toggleTheme() {
  const html = document.documentElement;
  if (html.getAttribute('data-theme') === 'dark') {
    html.setAttribute('data-theme', 'light');
  } else {
    html.setAttribute('data-theme', 'dark');
  }
}

function toggleFullScreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen().catch(err => {
      console.log(`Error attempting to enable full-screen mode: ${err.message}`);
    });
  } else {
    if (document.exitFullscreen) {
      document.exitFullscreen();
    }
  }
}

// Timer Simulation
let seconds = 3572; // 59:32
setInterval(() => {
  if(seconds > 0) seconds--;
  const m = Math.floor(seconds / 60).toString().padStart(2, '0');
  const s = (seconds % 60).toString().padStart(2, '0');
  document.getElementById('time-display').innerText = `${m}:${s}`;
}, 1000);

// Load the first question on startup
loadQuestion(currentIndex);

</script>
</body>
</html>

