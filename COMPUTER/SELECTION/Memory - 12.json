      "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">64 K</span></p>",
      "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">More than one of the above</span></p>"
    ],
    "correct": 3,
    "solution": "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000; font-weight: bold;\">Solution:</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">&nbsp;Correct Answer is 64 K</span><br><br><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000; font-weight: bold;\">Explanation:</span><br><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">Memory location FFFF is a&nbsp;</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000; font-weight: bold;\">hexadecimal</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">&nbsp;address, equivalent to decimal 65,535. Total memory size is determined by address lines. FFFF is the final address for a 16-bit address bus (2^16 = 65,536 locations), which corresponds to&nbsp;</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000; font-weight: bold;\">64 KB</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">&nbsp;of memory.</span></p>",
    "marks": "3",
    "question_hi": "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">कितने साइज के मेमोरी में आखिरी मेमोरी लोकेशन </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">FFFF </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">होगा</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">?</span></p><p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #3498DB;\">[BPSC TRE 2.0 Exam-2023 (11-12)]</span></p>",
    "options_hi": [
      "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">16 K</span></p>",
      "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">32 K</span></p>",
      "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">64 K</span></p>",
      "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">उपर्युक्त में से एक से अधिक</span></p>"
