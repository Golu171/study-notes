    "solution_hi": "<p style=\"margin-top: 0; margin-bottom: 0;\"><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000; font-weight: bold;\">हल:</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">&nbsp;</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">सही उत्तर है </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">64 K</span><br><br><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000; font-weight: bold;\">Explanation:</span><br><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">मेमोरी लोकेशन </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">FFFF </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">एक</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">&nbsp;</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000; font-weight: bold;\">हेक्साडेसिमल</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">&nbsp;</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">एड्रेस है</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">, </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">जो दशमलव में </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">65,535 </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">के बराबर है। कुल मेमोरी साइज की गणना एड्रेस लाइनों द्वारा की जाती है। </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">FFFF 16-</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">बिट एड्रेस बस (</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">2^16 = 65,536 </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">लोकेशन्स) का अंतिम एड्रेस है</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">, </span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">जो</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">&nbsp;</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000; font-weight: bold;\">64 KB</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">&nbsp;</span><span style=\"font-family: 'Times New Roman'; font-size: 13.5pt; color: #000000;\">मेमोरी के संगत है।</span></p>"
